.env
.env.*
!.env.example
*.secrets
*.pem
*.key
kubeconfig
kubeconfig*
*.kubeconfig
.kube/

# --- Python / local working dirs ---
__pycache__/
*.pyc
.venv/
venv/
work/
.idp-work/
