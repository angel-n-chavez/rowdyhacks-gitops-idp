# cp .env.example .env     (.env is gitignored; this repo is PUBLIC)

# PostgreSQL. Matches docker-compose.yml for local development.
# On the VM this comes from /etc/idp/database.env (same variable name).
# `postgresql://` and `postgresql+psycopg://` are both accepted.
DATABASE_URL=postgresql://idp:idp@localhost:5432/idp

# Apps are served at https://<app-name>.<PLATFORM_DOMAIN>. Required.
# Must match the wildcard DNS record we create in Stage 2. Confirm before the demo.
PLATFORM_DOMAIN=idp.angelchavez.net

# Pipeline worker threads. 1 = one deployment at a time (recommended).
JOB_WORKERS=1
